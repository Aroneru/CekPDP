# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=CekPDP
APP_ENV=local
# Generate with: php artisan key:generate
# Also encrypts stored policy text, reasons and evidence; rotating it makes
# existing (short-lived) analyses unreadable.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# The UI defaults to Bahasa Indonesia, with English as the fallback.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database: SQLite for local development and tests, MySQL in production
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cekpdp
# DB_USERNAME=cekpdp
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache, queue
# -----------------------------------------------------------------------------
# Sessions live in an encrypted cookie, so the server keeps no session records
# (the database driver would store every visitor's IP address and user agent).
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS only).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Analyses run in the background: a queue worker (php artisan queue:work)
# must be running, and so must the scheduler (php artisan schedule:work),
# which deletes expired analyses every minute. `composer dev` starts both.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# -----------------------------------------------------------------------------
# CekPDP
# -----------------------------------------------------------------------------
# Ruleset version used for new analyses (resources/rulesets/uu-pdp-27-2022/).
CEKPDP_RULESET_VERSION=1.0.0

# AI provider: "mock" runs offline with deterministic keyword matching and
# sends nothing to a third party. The "claude" provider is added in Milestone 3.
CEKPDP_AI_PROVIDER=mock

# Rules are sent to the provider in batches of this size.
CEKPDP_AI_BATCH_SIZE=8

# Longest policy accepted, in characters. Longer text is rejected with its
# actual size; it is never cut short.
CEKPDP_MAX_INPUT_CHARS=300000

# Accepted analyses per visitor per hour (keyed by a keyed hash of the IP).
CEKPDP_ANALYSES_PER_HOUR=10

# Minutes to keep the encrypted policy text and results after an analysis
# finishes, and before deleting an analysis that never finished.
CEKPDP_RETENTION_MINUTES=30
CEKPDP_PENDING_MINUTES=60

VITE_APP_NAME="${APP_NAME}"
